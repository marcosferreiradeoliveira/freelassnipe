# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3001"
PORT=3001

# 99FREELAS ACCOUNT & AUTOMATION CONFIGS
FREELAS_EMAIL="your_email"
FREELAS_PASSWORD="your_password"
FREELAS_SESSION_COOKIE="your_cookie_here"
PLAYWRIGHT_HEADLESS=true
# Deixe vazio para usar Chromium leve nos envios automáticos (menos RAM). O login manual usa Chrome real quando preciso.
# PLAYWRIGHT_CHANNEL=chrome
USE_PERSISTENT_PROFILE=true
PLAYWRIGHT_USER_DATA_DIR=.99freelas-profile
AUTO_SUBMIT=false
AUTO_SCRAPE=true
SCRAPE_START_PAGE=1
# Categorias separadas por vírgula. Também aceita query completa:
# web-mobile-e-software&sub-categorias=desenvolvimento-mobile
SCRAPE_CATEGORIES=web-mobile-e-software,vendas-e-marketing,fotografia-e-audiovisual,design-e-criacao
AUTO_LOOP_INTERVAL_MS=180000
SCRAPE_INTERVAL_MS=30000
MAX_PROPOSALS_PER_DAY=10
AUTOPILOT_BATCH_SIZE=10
AUTOPILOT_MAX_BIDS=5
AUTOPILOT_GENERATE_DELAY_MS=2500
AUTOPILOT_GENERATE_JITTER_MS=3500
AUTOPILOT_SUBMIT_DELAY_MS=45000
AUTOPILOT_SUBMIT_JITTER_MS=45000
# Multiplicador do preço sugerido pelo Gemini (0.5 = metade). Use 1 para desativar.
PROPOSAL_PRICE_FACTOR=0.5
